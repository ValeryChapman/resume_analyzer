# ––––––––––––––– DOCKER COMPOSE ––––––––––––––––
COMPOSE_PROJECT_NAME=resume_analyzer

# ––––––––––––––––––– POSTGRES ––––––––––––––––––
POSTGRES_HOST=postgres
POSTGRES_DB=resume_analyzer
POSTGRES_USER=root_user
POSTGRES_PASSWORD=root_password
POSTGRES_PORT_EXTERNAL=5432
POSTGRES_PORT_INTERNAL=5432

# –––––––––––––––––––– REDIS ––––––––––––––––––––
REDIS_HOST=redis
REDIS_DB=0
REDIS_USERNAME=default
REDIS_PASSWORD=root_password
REDIS_PORT_EXTERNAL=6379
REDIS_PORT_INTERNAL=6379

# ––––––––––––––––––––– LLM –––––––––––––––––––––
LLM_NAME=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=...
LLM_TIMEOUT=30

# ––––––––––––––––––– TELEGRAM ––––––––––––––––––
TELEGRAM_BOT_TOKEN=...

# –––––––––––––––––– HEADHUNTER –––––––––––––––––
HEADHUNTER_BASE_URL=https://api.hh.ru
HEADHUNTER_TOKEN=...
HEADHUNTER_TIMEOUT=30
HEADHUNTER_AREA=1
HEADHUNTER_PROFESSIONAL_ROLE=11
HEADHUNTER_ORDER_BY=publication_time
HEADHUNTER_PER_PAGE=10

# –––––––––– VACANCY PROCESSING SERVICE –––––––––
VACANCY_PROCESSING_SERVICE_CONSUMER_GROUP=vacancy_processing_service_group
VACANCY_PROCESSING_SERVICE_CONSUMER_NAME=vacancy_processing_service_consumer
VACANCY_PROCESSING_SERVICE_MAX_PARALLEL_TASKS=5
VACANCY_PROCESSING_SERVICE_READ_BLOCK_MS=5000
VACANCY_PROCESSING_SERVICE_ERROR_SLEEP_SECONDS=5
VACANCY_PROCESSING_SERVICE_STALE_TASK_IDLE_MS=60000
VACANCY_PROCESSING_SERVICE_RECLAIM_BATCH_SIZE=5
VACANCY_PROCESSING_SERVICE_MAX_DELIVERY_ATTEMPTS=3

# –––––––––––– RESUME PARSER SERVICE ––––––––––––
RESUME_PARSER_SERVICE_POLL_INTERVAL_SECONDS=300
RESUME_PARSER_SERVICE_LOOKBACK_SECONDS=3600
RESUME_PARSER_SERVICE_ERROR_SLEEP_SECONDS=30

# –––––––––– RESUME PROCESSING SERVICE ––––––––––
RESUME_PROCESSING_SERVICE_CONSUMER_GROUP=resume_processing_service_group
RESUME_PROCESSING_SERVICE_CONSUMER_NAME=resume_processing_service_consumer
RESUME_PROCESSING_SERVICE_MAX_PARALLEL_TASKS=5
RESUME_PROCESSING_SERVICE_READ_BLOCK_MS=5000
RESUME_PROCESSING_SERVICE_ERROR_SLEEP_SECONDS=5
RESUME_PROCESSING_SERVICE_STALE_TASK_IDLE_MS=60000
RESUME_PROCESSING_SERVICE_RECLAIM_BATCH_SIZE=5
RESUME_PROCESSING_SERVICE_MAX_DELIVERY_ATTEMPTS=3

# ––––––––––––––– MATCHING SERVICE ––––––––––––––
MATCHING_SERVICE_CONSUMER_GROUP=matching_service_group
MATCHING_SERVICE_CONSUMER_NAME=matching_service_consumer
MATCHING_SERVICE_MAX_PARALLEL_TASKS=5
MATCHING_SERVICE_READ_BLOCK_MS=5000
MATCHING_SERVICE_ERROR_SLEEP_SECONDS=5
MATCHING_SERVICE_STALE_TASK_IDLE_MS=60000
MATCHING_SERVICE_RECLAIM_BATCH_SIZE=5
MATCHING_SERVICE_MAX_DELIVERY_ATTEMPTS=3
MATCHING_SERVICE_NOTIFICATION_THRESHOLD=75

# –––––––––– NOTIFICATION SERVICE –––––––––
NOTIFICATION_SERVICE_CONSUMER_GROUP=notification_service_group
NOTIFICATION_SERVICE_CONSUMER_NAME=notification_service_consumer
NOTIFICATION_SERVICE_MAX_PARALLEL_TASKS=5
NOTIFICATION_SERVICE_READ_BLOCK_MS=5000
NOTIFICATION_SERVICE_ERROR_SLEEP_SECONDS=5
NOTIFICATION_SERVICE_STALE_TASK_IDLE_MS=60000
NOTIFICATION_SERVICE_RECLAIM_BATCH_SIZE=5
NOTIFICATION_SERVICE_MAX_DELIVERY_ATTEMPTS=3

# ––––––––––––––––––– BRANDING ––––––––––––––––––
TELEGRAM_BOT_NAME='Resume Analyzer'
